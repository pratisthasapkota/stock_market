# copy to .env and adjust. Nothing here is committed with real values.
DATABASE_URL=sqlite:///./data/stock.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-before-you-deploy-this
ACCESS_TOKEN_EXPIRE_MINUTES=720
# comma separated origins for the browser app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# when true the API runs crawl+categorize jobs inline instead of via Celery
INLINE_JOBS=false
SEED_ON_STARTUP=true
LOG_LEVEL=INFO

# Crawler knobs. The delay is passed to each spider subprocess as a scrapy
# setting (per-portal rate limiting); CRAWL_PORTAL_DELAYS overrides it for
# individual portals as JSON, e.g. CRAWL_PORTAL_DELAYS={"sharesansar": 3.0}
CRAWL_USER_AGENT=nepse-research-bot/0.1 (+contact: dev@example.com)
CRAWL_DELAY_SECONDS=1.5
CRAWL_MAX_PAGES_PER_PORTAL=40
CRAWL_PORTAL_DELAYS={}

# Demo login accounts. The seed creates these (hashed) on first boot, and
# /api/auth/demo-accounts serves them to the login page's hint list only while
# DEMO_MODE is on. Set DEMO_MODE=false and rotate the passwords before exposing
# the app anywhere real. The values below match the README's Demo Access table.
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
DEMO_ANALYST_EMAIL=analyst@demo.local
DEMO_ANALYST_USERNAME=analyst
DEMO_ANALYST_PASSWORD=analyst123
DEMO_VIEWER_EMAIL=viewer@demo.local
DEMO_VIEWER_USERNAME=viewer
DEMO_VIEWER_PASSWORD=viewer123

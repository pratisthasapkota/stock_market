# copy to .env and adjust. Nothing here is committed with real values.
DATABASE_URL=sqlite:///./data/stock.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-before-you-deploy-this
ACCESS_TOKEN_EXPIRE_MINUTES=720
# comma separated origins for the browser app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# when true the API runs crawl+categorize jobs inline instead of via Celery
INLINE_JOBS=false
SEED_ON_STARTUP=true
LOG_LEVEL=INFO
